########################################################################
# HELPER FUNCTIONS
# cheat.sh
function cheat() {
  curl "https://cheat.sh/$1"
}

# use Yazi and exit on cd
function yazy_cd() {
  local tmp=$(mktemp -t "yazi-cwd.XXXXXX") cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(<$tmp)" && [[ -n $cwd ]] && [[ $cwd != $PWD ]]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# deduplicate zsh history file
function history_deduplicate() {
  local before=$(wc -l <~/.zsh_history)
  tail -r ~/.zsh_history | awk '!seen[$0]++' | tail -r >~/.zsh_history.tmp && mv ~/.zsh_history.tmp ~/.zsh_history
  local after=$(wc -l <~/.zsh_history)
  echo "History deduplication: from $before --> $after lines."
}

# Manage docker compose services from ~/docker-services
# Usage: service <name> <docker-compose-args>
# Examples:
#   service redis-admin up -d
function service() {
  local svc=$1
  shift
  docker compose -f ~/docker-services/$svc/docker-compose.yml "$@"
}

# fzf history search ranked by frecency (frequency weighted by recency) - type 'his' instead of Ctrl+R
function his() {
  local selected_command
  selected_command=$(
    fc -lnt '%s' 1 |
      awk -v now="$(date +%s)" '{
        ts = $1; cmd = $0; sub(/^[0-9]+ +/, "", cmd)
        score[cmd] += 1 / (1 + (now - ts) / 86400 / 7)   # a use from 1 week ago counts half
      } END { for (c in score) printf "%f\t%s\n", score[c], c }' |
      sort -t$'\t' -k1,1 -rn | cut -f2- |
      fzf --scheme=history --height=40% --reverse --query="$*" --tiebreak=index
  )
  [[ -n "$selected_command" ]] && print -z "$selected_command"
}

# set the terminal tab/window title (disables OMZ auto-title so it sticks)
function set_terminal_title() {
  DISABLE_AUTO_TITLE="true"
  echo -en "\e]0;$*\a"
}

# re-enable OMZ auto-title (undo `st`)
function auto-st() {
  unset DISABLE_AUTO_TITLE
}

# sort vscode keybindings.json by key
function sort_vscode_keybindings() {
  local file="$HOME/git/dotfiles/vscode/keybindings.json"
  local tmp=$(mktemp)
  jq 'sort_by(.key)' "$file" > "$tmp" && mv "$tmp" "$file"
}

# cd into a directory and list its contents (grid view, capped at 50 entries, visible files first)
function cs() {
  cd "$1" || return
  local all=( *(ND) )
  local entries=( ${all:#.*} ${(M)all:#.*} )
  (( ${#entries} > 0 )) && eza -ad --sort=none "${entries[@]:0:50}"
}
compdef cs=cd

########################################################################
# HISTORY
HISTSIZE=10000
SAVEHIST=50000
export HISTFILE=~/.zsh_history
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_REDUCE_BLANKS

########################################################################
# MISE
export MISE_STATE_DIR="$HOME/.mise/state"
eval "$(mise activate zsh)"

########################################################################
# NVM
export NVM_DIR="$HOME/.nvm"

function _load_nvm() {
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}

# `nvm` itself is a shell function — stub it so the first call loads nvm.sh
function nvm() {
  unset -f nvm
  _load_nvm
  nvm "$@"
}

# Auto `nvm use` when entering a directory that contains a .nvmrc
function _load_nvm_on_nvmrc() {
  [[ -f .nvmrc ]] || return 0
  [[ -z "$NVM_BIN" ]] && _load_nvm
  nvm use
}
autoload -U add-zsh-hook
add-zsh-hook chpwd _load_nvm_on_nvmrc
_load_nvm_on_nvmrc

# Open the terminal scrollback in nvim
# herdr app: `sb`; ghostty: `sb ` then cmd+shift+s pastes the scrollback file path
function sb() {
  local nvim_view=(nvim -c "set buftype=nofile" -c "normal G")
  if [[ -n "$1" ]]; then
    "${nvim_view[@]}" "$1"
  elif [[ -n "$HC_TERMINAL_ID" ]]; then
    hc read "$HC_TERMINAL_ID" --lines 100000 | "${nvim_view[@]}" -
  else
    echo "sb: outside herdr, type 'sb ' then press cmd+shift+s" >&2
    return 1
  fi
}

########################################################################
# ZOXIDE
eval "$(zoxide init zsh --cmd z)"

########################################################################
# EDITOR
export EDITOR=nvim

########################################################################
# ALIASES
# file explorers/management
alias 'ls'='eza'
alias 'll'='eza -laT --level 1'
alias 'cd..'='cd ..'
alias 'y'='yazy_cd'
alias 'tree'='eza --tree --no-permissions --no-filesize --no-user --no-time'
# Notes
alias 'notes'='$EDITOR ~/notes'
# make python3 as default
alias 'python'='python3'
alias 'sourcevenv'='source .venv/bin/activate'
# edit .zshrc
alias "editrc"="$EDITOR ~/.zshrc"
alias "sourcerc"="source ~/.zshrc"
alias "catrc"="cat ~/.zshrc"
# docker compose
alias 'dc'='docker compose'
# Vim
alias "vim"="nvim"
# AI
alias "danger"="claude --dangerously-skip-permissions"
alias "plan"="claude --permission-mode plan"
alias "st"="set_terminal_title"

########################################################################
# PRIVATE
[[ -f "$HOME/.zshrc_private" ]] && source "$HOME/.zshrc_private"
